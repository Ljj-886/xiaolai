.page { min-height: 100vh; padding-bottom: env(safe-area-inset-bottom); }

.card { margin: 16rpx 24rpx; }
.status {
  background: #fff9ee;
  text-align: center; padding: 40rpx 32rpx;
}
.status-text {
  font-size: 40rpx; font-weight: 600; color: var(--primary);
}

.cover { width: 160rpx; height: 160rpx; border-radius: 12rpx; background: #f0e4d0; flex-shrink: 0; }
.avatar { width: 80rpx; height: 80rpx; border-radius: 50%; background: #f0e4d0; flex-shrink: 0; }
.peer-row { display: flex; align-items: center; gap: 16rpx; }
.price-row { display: flex; align-items: baseline; }

.kv {
  display: flex; padding: 16rpx 0;
  font-size: 28rpx;
  border-bottom: 1rpx solid var(--line);
}
.kv:last-child { border-bottom: none; }
.kv .k { width: 180rpx; color: var(--text-3); }
.kv .v { flex: 1; color: var(--text); }

.review { font-size: 26rpx; }
.ml-8 { margin-left: 8rpx; }
.mt-8 { margin-top: 8rpx; }
.text-warning { color: var(--warning); }

.bottom-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: #fff;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)) 24rpx;
  display: flex; gap: 16rpx;
}
.bottom-bar .btn { flex: 1; }
