.score-card { display: flex; align-items: center; gap: 32rpx; }
.score-ring {
  width: 180rpx; height: 180rpx; border-radius: 50%;
  background: #2e9e6b;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  color: #fff; flex-shrink: 0;
}
.score-num { font-size: 56rpx; font-weight: bold; line-height: 1.1; }
.score-label { font-size: 22rpx; opacity: 0.9; margin-top: 4rpx; }
.score-side { flex: 1; min-width: 0; }
.score-meta { display: flex; gap: 40rpx; }
.meta-item { display: flex; flex-direction: column; align-items: center; }
.meta-num { font-size: 32rpx; font-weight: bold; }
.rule { display: flex; gap: 20rpx; padding: 16rpx 0; align-items: flex-start; }
.rule-icon { font-size: 36rpx; width: 48rpx; text-align: center; }
.review { padding: 20rpx 0; border-bottom: 1rpx solid #f2eadc; }
.review:last-child { border-bottom: none; }
.stars { color: #FFB800; font-size: 26rpx; letter-spacing: 2rpx; }
