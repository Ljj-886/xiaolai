.page { min-height: 100vh; padding-bottom: env(safe-area-inset-bottom); }
.hero {
  margin: 24rpx; padding: 40rpx 32rpx;
  display: flex; flex-direction: column; align-items: center;
  background: #fff9ee;
}
.emoji-lg { font-size: 96rpx; }

.card { margin: 16rpx 24rpx; }
.form-item {
  display: flex; align-items: center; gap: 16rpx;
  padding: 24rpx 0; border-bottom: 1rpx solid var(--line);
}
.form-item:last-child { border-bottom: none; }
.label { flex-shrink: 0; min-width: 180rpx; color: var(--text-2); font-size: 28rpx; }
.ipt { flex: 1; min-width: 0; font-size: 28rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
/* picker 不是 flex 容器，但它是 form-item 的直接子节点 → 让它撑开，
   内部 .ipt 用 width:100% 填满（避免"专科"被折成两行） */
.form-item picker { flex: 1; min-width: 0; display: block; }
.form-item picker > .ipt { width: 100%; }

/* 学校搜索 input + 清空按钮 */
.ipt-wrap { flex: 1; position: relative; display: flex; align-items: center; }
.ipt-clear {
  position: absolute; right: 0; top: 50%; transform: translateY(-50%);
  width: 40rpx; height: 40rpx; line-height: 40rpx; text-align: center;
  color: #b39b80; font-size: 28rpx;
}
.school-item { flex-wrap: wrap; }
.school-item .label { width: 160rpx; }

/* 自动补全候选列表 */
.suggest {
  flex-basis: 100%;
  margin-top: 8rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  max-height: 600rpx;
  overflow-y: auto;
  box-shadow: none;
}
.suggest-item {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 24rpx; border-bottom: 1rpx solid var(--line);
}
.suggest-item:last-child { border-bottom: none; }
.suggest-item-hover { background: #f5eada; }
.suggest-name { flex: 1; font-size: 28rpx; color: var(--text); }
.suggest-level { color: var(--text-3); font-size: 22rpx; }
.suggest-manual .suggest-name { color: var(--primary); }

/* 表单项下方的帮助文字（独立成行，不再被 flex 行布局挤变形） */
.form-tip { padding: 0 0 24rpx 0; line-height: 1.6; }

/* 学历下拉：点输入框直接展开，模仿 school suggest 的视觉 */
.edu-trigger { cursor: pointer; }
.edu-dropdown { flex-basis: 100%; margin-top: 8rpx; background: #fff; border: 1rpx solid var(--line); border-radius: 12rpx; overflow: hidden; box-shadow: none; }
.edu-option { padding: 20rpx 24rpx; border-bottom: 1rpx solid var(--line); font-size: 28rpx; color: var(--text); }
.edu-option:last-child { border-bottom: none; }
.edu-option-hover { background: #f5eada; }
.edu-option-active { color: var(--primary); font-weight: 500; }

.image-grid {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx;
}
.image-item {
  position: relative; aspect-ratio: 1; background: #f0e4d0; border-radius: 12rpx; overflow: hidden;
}
.image-item image { width: 100%; height: 100%; }
.image-remove {
  position: absolute; top: 6rpx; right: 6rpx;
  width: 40rpx; height: 40rpx; line-height: 40rpx; text-align: center;
  background: rgba(0,0,0,0.6); color: #fff; border-radius: 50%;
  font-size: 24rpx;
}
.image-add {
  aspect-ratio: 1;
  border: 2rpx dashed #d8c6aa; border-radius: 12rpx;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  color: #b39b80; gap: 8rpx;
}
.image-add .plus { font-size: 48rpx; line-height: 1; color: var(--primary); }

/* 隐私政策明示同意 */
.agree-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 28rpx 24rpx;
}
.checkbox {
  flex-shrink: 0;
  width: 36rpx; height: 36rpx;
  margin-top: 6rpx;
  border: 2rpx solid #d8c6aa;
  border-radius: 50%;
  box-sizing: border-box;
  display: flex; align-items: center; justify-content: center;
}
.checkbox.checked { background: var(--primary); border-color: var(--primary); }
.checkbox .check { color: #fff; font-size: 22rpx; line-height: 1; }
.agree-row .link { color: var(--primary); }
.btn-disabled { opacity: 0.45; }

.bottom-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: #fff;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)) 24rpx;
}
