.page { min-height: 100vh; padding-bottom: calc(230rpx + env(safe-area-inset-bottom)); }

.card { margin: 16rpx 24rpx; }

.type-tabs { display: flex; padding: 8rpx; background: #f5eada; border-radius: 16rpx; }
.type-tab {
  flex: 1;
  display: flex; align-items: center; justify-content: center;
  height: 76rpx; margin: 0 6rpx; border-radius: 38rpx;
  font-size: 28rpx; line-height: 1;
  color: var(--ink-2); background: #fff;
  border: 3rpx solid var(--ink);
  transition: transform .08s ease, border-width .08s ease, background-color .08s ease;
}
.type-tab.active {
  background: var(--primary); color: #fff; font-weight: 500;
  border-color: var(--ink);
}
.image-grid {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx;
}
.image-item {
  position: relative; aspect-ratio: 1; background: #f0e4d0; border-radius: 12rpx; overflow: hidden;
}
.image-item image { width: 100%; height: 100%; }
.image-remove {
  position: absolute; top: 6rpx; right: 6rpx;
  width: 44rpx; height: 44rpx; line-height: 40rpx; text-align: center;
  background: rgba(0,0,0,0.62); color: #fff; border-radius: 50%;
  border: 3rpx solid var(--ink);
  font-size: 24rpx;
}
.image-cover {
  position: absolute; bottom: 6rpx; left: 6rpx;
  background: var(--primary); color: #fff;
  font-size: 20rpx; padding: 2rpx 8rpx; border-radius: 6rpx;
}
.image-add {
  aspect-ratio: 1;
  background: #fff;
  border: 3rpx dashed var(--ink); border-radius: 16rpx;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  color: #b39b80; gap: 8rpx;
}
.image-add .plus { font-size: 48rpx; line-height: 1; color: var(--primary); }

.title-input { font-size: 32rpx; padding: 8rpx 0; min-height: 44rpx; }
.desc-input { width: 100%; min-height: 200rpx; font-size: 28rpx; line-height: 1.6; }

.cat-grid, .cond-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.cat-pill {
  display: inline-flex; align-items: center; justify-content: center;
  height: 60rpx; padding: 0 28rpx; border-radius: 30rpx;
  font-size: 26rpx; line-height: 1; font-weight: 500;
  color: var(--ink-2); background: #fff;
  border: 3rpx solid var(--ink);
  transition: transform .08s ease, border-width .08s ease, background-color .08s ease;
  gap: 6rpx;
}
.pill-ico { width: 30rpx; height: 30rpx; margin-right: 2rpx; }

.cat-pill.active {
  background: var(--primary); color: #fff;
  border-color: var(--ink);
}

.price-input { display: flex; align-items: baseline; gap: 8rpx; padding: 8rpx 0; }
.price-input input { font-size: 40rpx; font-weight: 600; color: var(--primary); flex: 1; }
.price-input .price-symbol { font-size: 28rpx; }

.agree {
  display: flex; align-items: center; gap: 12rpx;
  padding: 16rpx 32rpx; color: var(--text-2);
}
.checkbox {
  width: 32rpx; height: 32rpx; border-radius: 50%;
  border: 2rpx solid #d8c6aa;
  background: #fff;
}
.checkbox.checked {
  background: var(--primary); border-color: var(--primary);
  position: relative;
}
.checkbox.checked::after {
  content: ''; position: absolute; left: 8rpx; top: 4rpx;
  width: 10rpx; height: 18rpx;
  border: solid #fff; border-width: 0 3rpx 3rpx 0;
  transform: rotate(45deg);
}

.bottom-bar {
  /* 自定义 tabBar 在页面内且 z-index 更高，底栏必须抬到它上方，否则发布按钮会被盖住 */
  position: fixed; left: 0; right: 0; bottom: calc(var(--tabbar-h) + env(safe-area-inset-bottom));
  background: #fff;
  padding: 16rpx 24rpx 16rpx 24rpx;
}
