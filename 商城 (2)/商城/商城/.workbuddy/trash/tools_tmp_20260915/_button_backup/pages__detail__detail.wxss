.page { min-height: 100vh; padding-bottom: env(safe-area-inset-bottom); background: var(--bg); }
.hero {
  width: 100%; height: 600rpx; background: #000;
}
.hero-img { width: 100%; height: 100%; }
.hero-indicator {
  position: absolute; right: 32rpx; top: 580rpx;
  background: rgba(0,0,0,0.5); color: #fff;
  padding: 6rpx 18rpx; border-radius: 24rpx; font-size: 22rpx;
}

.card { margin: 16rpx 24rpx; }
.info { padding: 24rpx; }
.price-row { display: flex; align-items: baseline; }
.title { font-size: 32rpx; font-weight: 600; line-height: 1.4; margin-top: 8rpx; }
.meta { display: flex; align-items: center; gap: 8rpx; flex-wrap: wrap; }
.desc { font-size: 28rpx; line-height: 1.7; color: var(--text-2); white-space: pre-wrap; word-break: break-all; }

.seller { display: flex; align-items: center; gap: 16rpx; }
.avatar { width: 80rpx; height: 80rpx; border-radius: 50%; background: #f0e4d0; }

.hint { text-align: center; }

.bottom-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: #fff;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)) 24rpx;
  display: flex; align-items: center; gap: 16rpx;
  box-shadow: none;
}
.bar-icon {
  display: flex; flex-direction: column; align-items: center;
  width: 96rpx; color: var(--text-2);
}
.bar-icon .emoji { font-size: 36rpx; }
.btn-buy {
  flex: 1; height: 80rpx; line-height: 80rpx;
  text-align: center; color: #fff;
  background: #e8542f;
  border-radius: 40rpx; font-size: 28rpx;
  box-shadow: none;
}
