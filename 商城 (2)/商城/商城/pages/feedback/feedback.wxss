.page { min-height: 100vh; padding-bottom: env(safe-area-inset-bottom); }
.card { margin: 16rpx 24rpx; }

.kind-list { display: flex; flex-wrap: wrap; gap: 12rpx; }
.kind {
  padding: 12rpx 24rpx; border-radius: 30rpx;
  background: #f5eada; color: var(--text-2); font-size: 24rpx;
}
.kind.active { background: var(--primary); color: #fff; }

.textarea { width: 100%; min-height: 200rpx; font-size: 28rpx; line-height: 1.6; }
.input { width: 100%; height: 72rpx; font-size: 28rpx; }

.image-grid {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx;
}
.image-item {
  position: relative; aspect-ratio: 1; background: #f0e4d0; border-radius: 12rpx; overflow: hidden;
}
.image-item image { width: 100%; height: 100%; }
.image-remove {
  position: absolute; top: 6rpx; right: 6rpx;
  width: 40rpx; height: 40rpx; line-height: 40rpx; text-align: center;
  background: rgba(0,0,0,0.6); color: #fff; border-radius: 50%;
  font-size: 24rpx;
}
.image-add {
  aspect-ratio: 1;
  border: 2rpx dashed #d8c6aa; border-radius: 12rpx;
  display: flex; align-items: center; justify-content: center;
  color: #d8c6aa;
}
.image-add .plus { font-size: 64rpx; }

.bottom-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: #fff;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)) 24rpx;
}
