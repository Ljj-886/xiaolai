.page { min-height: 100vh; }
.search-row {
  display: flex; align-items: center; gap: 16rpx;
  padding: 24rpx;
}
.search-input {
  background: #fff; border-radius: 36rpx;
  height: 72rpx; padding: 0 24rpx;
  display: flex; align-items: center; gap: 12rpx;
}
.search-input input { font-size: 28rpx; }
.cancel { color: var(--text-2); font-size: 28rpx; }

.filter { margin: 16rpx 24rpx; }
.chip-scroll { white-space: nowrap; width: 100%; }
.filter-row { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.chip {
  display: inline-flex; align-items: center; justify-content: center;
  height: 60rpx; padding: 0 28rpx; border-radius: 30rpx;
  font-size: 26rpx; line-height: 1; font-weight: 500;
  color: var(--ink-2); background: #fff;
  border: 3rpx solid var(--ink);
  transition: transform .08s ease, border-width .08s ease, background-color .08s ease;
}
.pill-ico { width: 28rpx; height: 28rpx; vertical-align: -4rpx; margin-right: 4rpx; }

.chip.on {
  background: var(--primary); color: #fff;
  border-color: var(--ink);
}
.chip.reset { background: #fff; border: 3rpx solid var(--ink); color: var(--ink-2); }
.price-row { align-items: center; }
.price-ipt {
  width: 160rpx; height: 56rpx; padding: 0 18rpx;
  background: #f2eadc; border-radius: 28rpx; font-size: 24rpx; text-align: center;
}
.price-sep { color: var(--text-3); font-size: 24rpx; }
.price-apply { background: #e8542f; color: #fff; }

.history, .hot { margin: 16rpx 24rpx; }
.tag-list { display: flex; flex-wrap: wrap; gap: 12rpx; }
.tag-list .tag { margin: 0; cursor: pointer; }

.result { padding: 16rpx 24rpx; }
.result-head { padding: 8rpx 0 16rpx; }
.grid {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}
.grid-cell { width: 100%; }
