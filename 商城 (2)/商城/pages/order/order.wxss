.page { min-height: 100vh; padding: 0 0 env(safe-area-inset-bottom); }
.tabs {
  display: flex; background: #fff;
  position: sticky; top: 0; z-index: 10;
  border-bottom: 1rpx solid var(--line);
}
.tab {
  flex: 1; text-align: center; padding: 24rpx 0;
  font-size: 26rpx; color: var(--text-2);
  position: relative;
}
.tab.active { color: var(--primary); font-weight: 500; }
.tab.active::after {
  content: ''; position: absolute; bottom: 0; left: 50%;
  transform: translateX(-50%); width: 40rpx; height: 4rpx;
  background: var(--primary); border-radius: 4rpx;
}

.card { margin: 16rpx 24rpx; }
.cover { flex-shrink: 0; width: 180rpx; height: 180rpx; border-radius: 12rpx; background: #f0e4d0; }
.price-row { display: flex; align-items: baseline; }
.order .actions {
  display: flex; justify-content: flex-end; gap: 12rpx; margin-top: 16rpx;
}

.form-item {
  display: flex; align-items: center; gap: 16rpx;
  padding: 24rpx 0; border-bottom: 1rpx solid var(--line);
}
.form-item:last-child { border-bottom: none; }
.label { width: 160rpx; color: var(--text-2); }
.ipt { flex: 1; font-size: 28rpx; }

.bottom-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: #fff;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)) 24rpx;
}
