.page { padding-bottom: calc(110rpx + env(safe-area-inset-bottom)); }

.search-bar {
  padding: 16rpx 24rpx 8rpx;
  background: var(--bg);
}
.search-input {
  background: #fff;
  border: 3rpx solid var(--ink);
  border-radius: 36rpx;
  height: 72rpx;
  display: flex; align-items: center;
  padding: 0 24rpx;
}
.search-input .iconfont { font-size: 30rpx; }

.banner {
  margin: 8rpx 24rpx 0;
  height: 240rpx;
  border-radius: 24rpx;
  overflow: hidden;
  border: 4rpx solid var(--ink); border-right-width: 8rpx; border-bottom-width: 8rpx;
  position: relative;
  z-index: 1;
}
.banner-card {
  height: 100%; padding: 40rpx;
  display: flex; flex-direction: column; justify-content: center;
  color: var(--ink);
}
.banner-title { font-size: 40rpx; font-weight: 600; }
.banner-sub { font-size: 26rpx; opacity: 0.9; margin-top: 8rpx; }

.cat-grid {
  margin: 24rpx;
  display: flex; flex-wrap: wrap;
  padding: 24rpx 12rpx;
}
.cat-item {
  width: 20%;
  display: flex; flex-direction: column; align-items: center;
  padding: 12rpx 0;
  gap: 12rpx;
}
.cat-item:active { opacity: 0.6; }
.cat-icon {
  width: 88rpx; height: 88rpx; border-radius: 26rpx;
  background: #fff;
  border: 5rpx solid var(--ink);
  padding: 8rpx;
}
/* 卡通贴纸感：自绘图标 + 轻微倾斜（像随手贴上去的贴纸） */
.cat-item:nth-child(1) .cat-icon { transform: rotate(-3deg); }
.cat-item:nth-child(2) .cat-icon { transform: rotate(2.5deg); }
.cat-item:nth-child(3) .cat-icon { transform: rotate(-2deg); }
.cat-item:nth-child(4) .cat-icon { transform: rotate(3deg); }
.cat-item:nth-child(5) .cat-icon { transform: rotate(-2.5deg); }
.cat-item:nth-child(6) .cat-icon { transform: rotate(2deg); }
.cat-item:nth-child(7) .cat-icon { transform: rotate(-3deg); }
.cat-item:nth-child(8) .cat-icon { transform: rotate(2.5deg); }
.cat-item:nth-child(9) .cat-icon { transform: rotate(-2deg); }
.cat-item:nth-child(10) .cat-icon { transform: rotate(3deg); }

.section { margin: 24rpx; }
.school-tip {
  background: #FFF7ED;
  border: 1rpx solid #FFE0C2;
  color: #C2410C;
  font-size: 24rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}
.school-tip:active { opacity: 0.7; }
.section-head {
  display: flex; justify-content: space-between; align-items: baseline;
  margin-bottom: 16rpx;
}
.type-switch { display: inline-flex; background: #f5eada; border-radius: 30rpx; padding: 4rpx; }
.type-switch-item {
  display: inline-flex; align-items: center; justify-content: center;
  height: 60rpx; padding: 0 28rpx; border-radius: 30rpx;
  font-size: 26rpx; line-height: 1; font-weight: 500;
  color: var(--ink-2); background: #fff;
  border: 3rpx solid var(--ink);
  transition: transform .08s ease, border-width .08s ease, background-color .08s ease;
}
.type-switch-item.active {
  background: var(--primary); color: #fff;
  border-color: var(--ink);
}
.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}
.grid-cell { width: 100%; }

/* 首屏骨架屏（shimmer 微光） */
.sk-card { background: #fff; border-radius: 20rpx; overflow: hidden; border: 4rpx solid var(--ink); border-right-width: 8rpx; border-bottom-width: 8rpx; }
.sk-img { width: 100%; aspect-ratio: 1 / 1; background: #f0e4d0; }
.sk-line { height: 28rpx; margin: 16rpx 16rpx 0; border-radius: 8rpx; background: #f0e4d0; }
.sk-line.sk-sm { width: 50%; margin-bottom: 16rpx; }
.sk-img, .sk-line { position: relative; overflow: hidden; }
.sk-img::after, .sk-line::after {
  content: ''; position: absolute; top: 0; left: -100%; width: 100%; height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,.7), transparent);
  animation: sk-shimmer 1.3s infinite;
}
@keyframes sk-shimmer { 100% { left: 100%; } }
