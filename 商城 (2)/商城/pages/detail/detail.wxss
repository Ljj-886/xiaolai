.page { min-height: 100vh; padding-bottom: env(safe-area-inset-bottom); background: var(--bg); }
.hero {
  position: relative;
  width: 100%; height: 600rpx; background: #000;
}
.hero-img { width: 100%; height: 100%; }
/* 无图求购的占位区：不求高大，避免空出整屏白块 */
.hero-want {
  height: 320rpx; margin: 16rpx 24rpx 0;
  background: var(--card); border: 4rpx solid var(--ink); border-radius: var(--radius);
  border-bottom-width: 8rpx;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx;
}
.hero-want-ico { font-size: 56rpx; }
.hero-want-t { font-size: 28rpx; font-weight: 600; color: var(--ink); }
.hero-want-s { font-size: 24rpx; color: var(--ink-3); }
.hero-indicator {
  position: absolute; right: 32rpx; top: 580rpx;
  background: rgba(0,0,0,0.5); color: #fff;
  padding: 6rpx 18rpx; border-radius: 24rpx; font-size: 22rpx;
}

.card { margin: 16rpx 24rpx; }

/* 卖家视角提示：为什么这件商品没出现在首页 */
.notice { padding: 20rpx 24rpx; border-left-width: 8rpx; }
.notice-head { display: flex; align-items: center; gap: 8rpx; }
.notice-ico { font-size: 30rpx; }
.notice-title { font-size: 28rpx; font-weight: 600; color: var(--ink); }
.notice-row { display: flex; gap: 8rpx; align-items: flex-start; margin-top: 8rpx; font-size: 24rpx; line-height: 1.5; }
.notice-k { flex-shrink: 0; color: var(--ink-3); }
.notice-v { flex: 1; color: #9E2A1B; word-break: break-all; }
.notice-desc { margin-top: 8rpx; font-size: 24rpx; color: var(--ink-3); line-height: 1.5; }
.info { padding: 24rpx; }
.price-row { display: flex; align-items: baseline; }
.title { font-size: 32rpx; font-weight: 600; line-height: 1.4; margin-top: 8rpx; }
.meta { display: flex; align-items: center; gap: 8rpx; flex-wrap: wrap; }
.desc { font-size: 28rpx; line-height: 1.7; color: var(--text-2); white-space: pre-wrap; word-break: break-all; }

.seller { display: flex; align-items: center; gap: 16rpx; }
.avatar { width: 80rpx; height: 80rpx; border-radius: 50%; background: #f0e4d0; }

.hint { text-align: center; }

.bottom-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: #fff;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)) 24rpx;
  display: flex; align-items: center; gap: 16rpx;
  box-shadow: none;
}
.bar-icon {
  display: flex; flex-direction: column; align-items: center;
  width: 96rpx; color: var(--text-2);
}
.bar-icon .emoji { width: 44rpx; height: 44rpx; }
.btn-buy {
  flex: 1; height: 88rpx; line-height: 1;
  display: flex; align-items: center; justify-content: center;
  color: #fff; background: var(--primary);
  border: 4rpx solid var(--ink);
  border-right-width: 8rpx; border-bottom-width: 8rpx;
  border-radius: 44rpx; font-size: 30rpx; font-weight: 500;
  transition: transform .08s ease, border-width .08s ease, background-color .08s ease;
}

/* 价格旁小提示（替代原「原价」删除线文案）：无删除线的浅色小字 */
.price-tip { color: var(--text-3); font-size: 24rpx; margin-left: 8rpx; }
