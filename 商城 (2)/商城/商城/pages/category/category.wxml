<wxs src="../../utils/icon.wxs" module="ico" />
<view class="page">
  <view class="layout">
    <!-- 左侧分类 -->
    <scroll-view class="left" scroll-y>
      <view wx:for="{{cats}}" wx:key="key"
        class="left-item {{item.key === current ? 'active' : ''}}"
        bindtap="selectCat" data-key="{{item.key}}">
        <image class="left-icon" src="{{ico.cat(item.key)}}" mode="aspectFit"/>
        <text class="text-sm">{{item.name}}</text>
      </view>
    </scroll-view>

    <!-- 右侧筛选 + 列表 -->
    <view class="right">
      <view class="filter">
        <view class="filter-item {{sort === 'new' ? 'active' : ''}}" bindtap="setSort" data-sort="new" hover-class="press" hover-stay-time="80">最新</view>
        <view class="filter-item {{sort === 'priceAsc' ? 'active' : ''}}" bindtap="setSort" data-sort="priceAsc" hover-class="press" hover-stay-time="80">价低</view>
        <view class="filter-item {{sort === 'priceDesc' ? 'active' : ''}}" bindtap="setSort" data-sort="priceDesc" hover-class="press" hover-stay-time="80">价高</view>
        <view class="filter-item {{sort === 'hot' ? 'active' : ''}}" bindtap="setSort" data-sort="hot" hover-class="press" hover-stay-time="80">热门</view>
      </view>

      <scroll-view class="list" scroll-y lower-threshold="120" bindscrolltolower="onReachBottom">
        <view class="list-wrap">
          <view class="grid">
            <view class="grid-cell" wx:for="{{list}}" wx:key="_id">
              <goods-card item="{{item}}" bind:tap="goDetail" data-id="{{item._id}}"/>
            </view>
          </view>
          <view wx:if="{{!loading && loadError}}">
            <empty icon="⚠️" title="加载失败" desc="{{loadError}}" actionText="重试" bind:action="retry"/>
          </view>
          <view wx:elif="{{!loading && list.length === 0}}">
            <empty icon="🔍" title="该分类暂无商品" desc="切换其他分类或直接搜索"/>
          </view>
          <view wx:if="{{loading}}" class="loading">加载中…</view>
          <view wx:elif="{{hasMore}}" class="loading" bindtap="loadMore">点击加载更多</view>
          <view wx:elif="{{list.length > 0}}" class="loading">— 没有更多了 —</view>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
