.page { height: calc(100vh - 110rpx - env(safe-area-inset-bottom)); }
.layout { display: flex; height: 100%; }
.left {
  width: 180rpx; background: #fff;
  border-right: 1rpx solid var(--line);
  height: 100%;
}
.left-item {
  padding: 32rpx 12rpx;
  display: flex; flex-direction: column; align-items: center; gap: 8rpx;
  color: var(--text-2);
  position: relative;
  font-size: 24rpx;
}
.left-item.active {
  color: var(--primary); font-weight: 500; background: #fff9ee;
}
.left-icon {
  width: 64rpx; height: 64rpx; border-radius: 18rpx;
  background: var(--primary-light);
  border: 5rpx solid var(--ink);
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx;
}

.left-item.active::before {
  content: ''; position: absolute; left: 0; top: 50%;
  transform: translateY(-50%); width: 6rpx; height: 40rpx;
  background: var(--primary); border-radius: 0 4rpx 4rpx 0;
}

.right { flex: 1; display: flex; flex-direction: column; height: 100%; min-width: 0; }
.filter {
  display: flex; background: #fff;
  border-bottom: 1rpx solid var(--line);
}
.filter-item {
  flex: 1; text-align: center; padding: 24rpx 0;
  font-size: 26rpx; color: var(--text-2);
  position: relative;
}
.filter-item.active { color: var(--primary); font-weight: 500; }
.filter-item.active::after {
  content: ''; position: absolute; bottom: 0; left: 50%;
  transform: translateX(-50%); width: 48rpx; height: 4rpx;
  background: var(--primary); border-radius: 4rpx;
}
.list { flex: 1; }
.list-wrap { padding: 16rpx; }
.grid {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}
.grid-cell { width: 100%; }
