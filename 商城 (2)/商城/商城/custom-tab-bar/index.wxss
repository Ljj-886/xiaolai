/* 自定义 tabBar —— 卡通贴纸风：圆角"贴纸条" + 选中项落进珊瑚气泡 + 点按弹跳 */
.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: flex-start;
  background: var(--bg, #FFF9EE);
  border-top: 4rpx solid var(--ink, #3D2B1F);
  border-left: 4rpx solid var(--ink, #3D2B1F);
  border-right: 4rpx solid var(--ink, #3D2B1F);
  border-radius: 32rpx 32rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 999;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 14rpx 0 16rpx;
}
.tab-hover { opacity: 0.72; }

.tab-ico-wrap {
  position: relative;
  width: 46rpx;
  height: 46rpx;
}
.tab-ico { width: 46rpx; height: 46rpx; }

/* 选中：图标落进一个珊瑚色圆气泡里（卡通感的关键） */
.tab-item.on .tab-ico-wrap::before {
  content: '';
  position: absolute;
  left: -13rpx;
  top: -11rpx;
  right: -13rpx;
  bottom: -11rpx;
  background: var(--primary-light, #FFE3D6);
  border: 3rpx solid var(--ink, #3D2B1F);
  border-radius: 50%;
}
.tab-item.on .tab-ico { position: relative; z-index: 1; }
.tab-item.on .tab-ico-wrap { animation: tabPop .3s cubic-bezier(.34, 1.56, .64, 1); }

@keyframes tabPop {
  0% { transform: scale(.82); }
  60% { transform: scale(1.08); }
  100% { transform: scale(1); }
}

.tab-badge {
  position: absolute;
  top: -14rpx;
  right: -18rpx;
  min-width: 30rpx;
  height: 30rpx;
  line-height: 28rpx;
  padding: 0 6rpx;
  border-radius: 16rpx;
  background: var(--danger, #D93B2B);
  color: #fff;
  font-size: 18rpx;
  text-align: center;
  border: 2rpx solid var(--ink, #3D2B1F);
  z-index: 2;
}

.tab-txt {
  font-size: 20rpx;
  color: var(--ink-3, #B39B80);
  line-height: 1.2;
}
.tab-item.on .tab-txt {
  color: var(--primary, #E8542F);
  font-weight: 500;
}
