.page { min-height: 100vh; padding-bottom: calc(var(--tabbar-h) + env(safe-area-inset-bottom)); }

.header {
  position: relative;
  padding: 32rpx 24rpx 0;
  color: #fff;
}
.header-bg {
  position: absolute; left: 16rpx; right: 16rpx; top: 0;
  height: 380rpx;
  background: var(--primary);
  border: 4rpx solid var(--ink);
  border-top: none;
  border-radius: 0 0 28rpx 28rpx;
  z-index: -1;
}
.profile {
  display: flex; align-items: center; gap: 24rpx;
  padding: 32rpx 16rpx 0;
}
.login-hint {
  display: flex; align-items: center; gap: 24rpx;
  padding: 32rpx 16rpx 0;
}
.login-hint .name { color: #fff; }
.avatar {
  width: 128rpx; height: 128rpx; border-radius: 50%;
  background: rgba(255,255,255,0.2);
  border: 4rpx solid rgba(255,255,255,0.6);
}
.info { flex: 1; min-width: 0; }
.name-row { display: flex; align-items: center; gap: 12rpx; }
.name { font-size: 36rpx; font-weight: 600; max-width: 320rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.stats {
  display: flex; justify-content: space-between;
  background: rgba(255,255,255,0.18);
  border-radius: 16rpx;
  padding: 24rpx 12rpx;
  margin: 24rpx 0;
}
.stat { flex: 1; text-align: center; }
.num { display: block; font-size: 36rpx; font-weight: 600; }

.mt-24 { margin-top: 24rpx; }

.order-grid {
  display: flex; justify-content: space-between;
  margin-top: 24rpx;
}
.order-cell {
  flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8rpx;
  color: var(--text-2); padding: 12rpx 0;
}
/* 图标按钮底托：与首页分类宫格、tabBar 图标同一套「描边贴纸」视觉 */
.order-cell .emoji {
  width: 80rpx; height: 80rpx; border-radius: 24rpx;
  background: #fff; border: 4rpx solid var(--ink);
  padding: 8rpx;
  transition: transform .08s ease;
}
/* 卡通感：自绘图标 + 轻微倾斜 */
.order-grid .order-cell:nth-child(1) .emoji { transform: rotate(-3deg); }
.order-grid .order-cell:nth-child(2) .emoji { transform: rotate(2.5deg); }
.order-grid .order-cell:nth-child(3) .emoji { transform: rotate(-2.5deg); }
.order-grid .order-cell:nth-child(4) .emoji { transform: rotate(3deg); }

.cell-list { display: flex; flex-direction: column; }
.cell {
  display: flex; align-items: center; gap: 16rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.cell:last-child { border-bottom: none; }
.cell .emoji { width: 40rpx; height: 40rpx; flex-shrink: 0; }
.cell:active { opacity: 0.5; }
